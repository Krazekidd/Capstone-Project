OPENROUTER_API_KEY=your_openrouter_api_key_here
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/chatbot_db

# Server configuration (optional - defaults shown)
HOST=0.0.0.0
PORT=8000

# Chatbot context window (optional - default: 8)
MAX_CONTEXT_MESSAGES=8

# Email Configuration (optional - required for email features)
# Brevo API Settings (recommended)
BREVO_API_KEY=your_brevo_api_key_here
FROM_EMAIL=hello@brevo.com
FROM_NAME=GymPRO

# Legacy SMTP Settings (alternative to Resend)
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

FRONTEND_URL=http://localhost:5173